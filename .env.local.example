NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ANTHROPIC_API_KEY=your-anthropic-key

# Optional. Comma-separated emails allowed to trigger AI generation (every
# call runs through the ANTHROPIC_API_KEY above, so this caps who can spend
# your budget). Leave unset to allow any signed-in user - fine while your
# deployment URL is private, strongly recommended once it's shared publicly.
ALLOWED_EMAILS=you@example.com,teammate@example.com
